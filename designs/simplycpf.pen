                          "content": "Overview",
                          "fontFamily": "Inter",
                          "fontSize": 20,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "s0QYf",
                          "name": "sec1b",
                          "fill": "$--muted-foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "This page explains how CPF contribution rules work in practice and where key thresholds apply. Use it as a quick reference before using calculators or planning salary changes.",

                          "name": "sec2h",
                          "fill": "$--foreground",
                          "content": "Contribution ceiling",
                          "fontFamily": "Inter",
                          "fontSize": 20,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "TFMfe",
                          "name": "sec2b",
                          "fill": "$--muted-foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "From January 2026, Ordinary Wages are subject to CPF up to the $8,000 monthly OW ceiling. Additional Wages use a separate annual ceiling and require annual OW and prior-AW context.",
                          "lineHeight": 1.5,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]

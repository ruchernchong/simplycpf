                  "id": "TK42Z",
                  "fill": "$--muted-foreground",
                  "content": "Effective date: 19 April 2026",
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "ltdgo",
                  "name": "intro",
                  "fill": "$--muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "This page explains what limited data SimplyCPF handles, how it is used, and the choices available to you.",
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "Iyefm",
                  "name": "pvCard",
                  "width": "fill_container",
                  "fill": "$--card",
                  "cornerRadius": 12,
                  "stroke": {
                    "align": "inside",
                    "thickness": 1,
                    "fill": "$--border"
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": 24,
                  "children": [
                    {
                      "type": "frame",
                      "id": "VbRqr",
                      "name": "s1",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 8,
                      "children": [
                        {
                          "type": "text",
                          "id": "eLjtr",
                          "fill": "$--foreground",
                          "content": "1. Information We Collect",
                          "fontFamily": "Inter",
                          "fontSize": 18,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "xbCUX",
                          "fill": "$--muted-foreground",
                          "content": "The core calculators work entirely in your browser — your income, age, and all calculation inputs stay on your device. We only collect your email address when you explicitly request a CPF cheat sheet or readiness report.",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "NapgI",
                      "name": "s2",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 8,
                      "children": [
                        {
                          "type": "text",
                          "id": "wDwdb",
                          "fill": "$--foreground",
                          "content": "2. How We Use Information",
                          "fontFamily": "Inter",
                          "fontSize": 18,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "9putA",
                          "fill": "$--muted-foreground",
                          "content": "Email addresses are used solely to send the requested resource. We do not sell or share your data with third parties. We do not send marketing emails unless you opt in separately.",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "egbzk",
                      "name": "s3",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 8,
                      "children": [
                        {
                          "type": "text",
                          "id": "UfvuT",
                          "fill": "$--foreground",
                          "content": "3. Analytics",
                          "fontFamily": "Inter",
                          "fontSize": 18,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "jeG11",
                          "fill": "$--muted-foreground",
                          "content": "We use privacy-respecting analytics to understand how the tool is used. No personal identifiers are collected, and your IP address is not stored.",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "1HE2p",
                      "name": "s4",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 8,
                      "children": [
                        {
                          "type": "text",
                          "id": "nz93F",
                          "fill": "$--foreground",
                          "content": "4. Your Rights",
                          "fontFamily": "Inter",
                          "fontSize": 18,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "1n67l",
                          "fill": "$--muted-foreground",
                          "content": "You can request deletion of your email address from our mailing list at any time. Contact us via the GitHub repository for any privacy-related concerns.",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "ry5zg",
                      "name": "sec5",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 8,
                      "children": [
                        {
                          "type": "text",
                          "id": "Sanu3",
                          "fill": "$--foreground",
                          "content": "5. Data Retention",
                          "fontFamily": "Inter",
                          "fontSize": 18,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "nwMFi",
                          "fill": "$--muted-foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "If you provide an email address to receive a requested resource, it is retained only as needed to deliver that request and manage related support. You may request deletion at any time.",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "TLItj",
                      "name": "sec6",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 8,
                      "children": [
                        {
                          "type": "text",
                          "id": "X6ips",
                          "fill": "$--foreground",
                          "content": "6. Cookies and Local Storage",
                          "fontFamily": "Inter",
                          "fontSize": 18,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "exesu",
                          "fill": "$--muted-foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "SimplyCPF may use essential browser storage to preserve your preferences and improve usability. These settings stay in your browser and can be cleared through browser controls.",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "anoXw",
                      "name": "sec7",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 8,
                      "children": [
                        {
                          "type": "text",
                          "id": "q8Thw",
                          "fill": "$--foreground",
                          "content": "7. Third-Party Services",
                          "fontFamily": "Inter",
                          "fontSize": 18,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "xP5BQ",
                          "fill": "$--muted-foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Where third-party services are used (for example, hosting or privacy-focused analytics), they are selected to support service operation. SimplyCPF does not sell personal data to advertisers.",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "wrGsq",
                      "name": "sec8",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 8,
                      "children": [
                        {
                          "type": "text",
                          "id": "9crZz",
                          "fill": "$--foreground",
                          "content": "8. Changes to This Policy",
                          "fontFamily": "Inter",
                          "fontSize": 18,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "GZdGP",
                          "fill": "$--muted-foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "This policy may be updated when product functionality, legal requirements, or data practices change. The effective date at the top of this page will reflect the latest revision.",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "FK0kq",
                      "name": "sec9",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 8,
                      "children": [
                        {
                          "type": "text",
                          "id": "2TCIt",
                          "fill": "$--foreground",
                          "content": "9. Contact",
                          "fontFamily": "Inter",
                          "fontSize": 18,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "ZfAeW",
                          "fill": "$--muted-foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "For privacy questions or deletion requests, contact the SimplyCPF maintainers through the project GitHub repository.",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }

                          "type": "text",
                          "id": "CfluN",
                          "fill": "$--foreground",
                          "content": "3. Analytics",
                          "fontFamily": "Inter",
                          "fontSize": 18,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "TTvo1",
                          "fill": "$--muted-foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "We use privacy-respecting analytics to understand how the tool is used. No personal identifiers are collected, and your IP address is not stored.",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]

                        {
                          "type": "text",
                          "id": "uqiih",
                          "fill": "$--foreground",
                          "content": "1. Purpose",
                          "fontFamily": "Inter",
                          "fontSize": 16,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "PptNo",
                          "fill": "$--foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                      "content": "SimplyCPF covers private-sector, non-pensionable Singapore Citizen and SPR employees using default G/G rates. Platform workers, self-employed or pensionable employees, and alternative PR arrangements are out of scope.",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "thFBX",
                      "name": "sec2",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 8,
                      "children": [
                        {
                          "type": "text",
                          "id": "p6gLf",
                          "fill": "$--foreground",
                          "content": "2. Scope of Information",
                          "fontFamily": "Inter",
                          "fontSize": 16,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "oi1hP",
                          "fill": "$--foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                      "content": "Contribution and allocation rates use inclusive age bands. The retirement share goes to SA below 55; after SA closure it goes to RA until FRS, then OA. MA receives its published share first and OA receives the remainder.",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "Kz6j7",
                      "name": "sec3",

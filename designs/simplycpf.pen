                          "type": "text",
                          "id": "CPQkl",
                          "name": "sec3b",
                          "fill": "$--muted-foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Contribution shares use inclusive age bands. After SA closes from age 55, the retirement share routes to RA until FRS is set aside, then to OA; account context determines the branch.",

                      "children": [
                        {
                          "type": "text",
                          "id": "VTY1d",
                          "fill": "$--foreground",
                          "content": "2. Scope of Information",
                          "fontFamily": "Inter",
                          "fontSize": 16,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "XHX2i",
                          "fill": "$--foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "CPF contribution rates vary across age groups, and allocations across Ordinary Account (OA), Special Account (SA), and MediSave Account (MA) differ by profile. This page summarises those mechanics in a practical, readable format.",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",

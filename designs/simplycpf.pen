                          "fontSize": 18,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "fNa9T",
                          "fill": "$--muted-foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "If you provide an email address to receive a requested resource, it is retained only as needed to deliver that request and manage related support. You may request deletion at any time.",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"

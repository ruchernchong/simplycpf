                        {
                          "type": "text",
                          "id": "AlSKb",
                          "fill": "$--muted-foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Each quarter, CPF reviews the rolling 12-month average 10-year SGS yield and sets SMRA rates to that value plus 1%. If the formula falls below 4%, the floor rate applies.",

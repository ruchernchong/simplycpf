                          "fontFamily": "Inter",
                          "fontSize": 20,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "KctHV",
                          "name": "sec2b",
                          "fill": "$--muted-foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "From September 2026, ordinary wages are subject to CPF up to a monthly income ceiling of $8,000. Any wages above that amount are not counted for compulsory CPF contributions, though additional voluntary top-ups may still be possible under separate limits.",
                          "lineHeight": 1.5,
                          "fontFamily": "Inter",
                          "fontSize": 14,

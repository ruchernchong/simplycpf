                      "children": [
                        {
                          "type": "text",
                          "id": "Lxbf0",
                          "fill": "$--foreground",
                          "content": "1. Purpose",
                          "fontFamily": "Inter",
                          "fontSize": 16,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "U5C5E",
                          "fill": "$--foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "SimplyCPF is a free, open-source CPF planning tool for Singapore Citizens and Permanent Residents. It helps users estimate CPF contributions and projected outcomes based on income, age group, and prevailing contribution rules.",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "AZ5nO",
                      "name": "sec2",
                      "width": "fill_container",
                      "layout": "vertical",

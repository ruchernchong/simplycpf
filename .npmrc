# Block install-time scripts (primary malware vector)
# Developers must run `pnpm run prepare` manually after cloning to init Husky hooks.
ignore-scripts=true

# Lock to official npm registry
registry=https://registry.npmjs.org/

# Pin exact versions on 'pnpm add' (no ^ or ~ ranges)
save-exact=true

# Quarantine newly published packages for 3 days (4320 minutes)
# Mitigates typosquatting, protestware, and account compromise attacks.
# Override with `pnpm install --force` if urgent security patch needed.
minimum-release-age=4320

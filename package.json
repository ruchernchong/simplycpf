{
  "name": "simplycpf",
  "description": "Calculate your CPF contributions with the latest income ceiling changes. Your CPF, simplified.",
  "version": "1.11.2",
  "type": "module",
  "scripts": {
    "dev": "portless run next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format src --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "semantic-release",
    "prepare": "husky",
    "typecheck": "next typegen && tsc --noEmit",
    "generate:docs": "pnpm dlx tsx scripts/generate-docs.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.0.0",
    "@hugeicons/core-free-icons": "3.1.0",
    "@hugeicons/react": "1.1.4",
    "@react-pdf/renderer": "4.3.2",
    "@tailwindcss/postcss": "4.1.17",
    "@vercel/analytics": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "2.30.0",
    "fumadocs-core": "16.7.12",
    "fumadocs-mdx": "14.2.2",
    "fumadocs-openapi": "10.6.7",
    "fumadocs-twoslash": "3.1.15",
    "fumadocs-ui": "16.7.12",
    "motion": "12.23.26",
    "next": "16.2.3",
    "next-themes": "0.4.6",
    "nuqs": "2.8.9",
    "posthog-js": "1.367.0",
    "posthog-node": "5.29.2",
    "react": "19.2.3",
    "react-day-picker": "8.10.1",
    "react-dom": "19.2.3",
    "recharts": "2.15.4",
    "tailwind-merge": "2.6.0",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "10.3.5",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "14.3.1",
    "@types/mdx": "2.0.13",
    "@types/node": "24.10.4",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.0.16",
    "babel-plugin-react-compiler": "1.0.0",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "husky": "9.1.7",
    "jsdom": "27.2.0",
    "lint-staged": "16.2.7",
    "portless": "0.10.1",
    "postcss": "8.5.6",
    "schema-dts": "1.1.5",
    "semantic-release": "24.2.9",
    "shadcn": "3.5.0",
    "tailwindcss": "4.1.17",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.0.3",
    "vitest": "4.0.16"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx,json}": [
      "pnpm biome check --write"

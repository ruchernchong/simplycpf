{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "heroui-pro": {
      "type": "remote",
      "url": "https://mcp.heroui.pro/mcp",
      "headers": {
        "x-heroui-personal-token": "{env:HEROUI_PERSONAL_TOKEN}",
      },
      "enabled": true,
    },
    "heroui-react": {
      "type": "local",
      "command": ["bunx", "-y", "@heroui/react-mcp@latest"],
      "enabled": true,
    },
    "shadcn": {
      "type": "local",
      "command": ["bunx", "shadcn@latest", "mcp"],
    },
  },
}
